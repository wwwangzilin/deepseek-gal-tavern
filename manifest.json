{
  "manifest_version": 3,
  "name": "DeepSeek GAL 酒馆",
  "version": "2.0.0",
  "description": "把网页版 DeepSeek 变成 Galgame 角色扮演酒馆，完整内置 DeepSeek++ 功能：记忆系统/Skill/预设/对话管理/MCP 工具/侧栏管理。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "GAL 酒馆侧栏"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://chat.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://chat.deepseek.com/*"],
      "js": ["src/skill-tools.js", "src/main-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://chat.deepseek.com/*"],
      "js": ["src/styles.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.png"],
      "matches": ["*://chat.deepseek.com/*"]
    }
  ]
}
